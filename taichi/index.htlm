
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tai Chi · Flujo Natural</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
<style>
  :root { --bg:#f6f1e7; --ink:#2b2a28; --gold:#e8d9b0; --gold-deep:#6a5a33; --card:#fdf6e3; --border:#d9c49a; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --bg:#1c1a16; --ink:#f2ede0; --gold:#4a3f26; --gold-deep:#e8d9b0; --card:#262019; --border:#4a3f26; }
  }
  * { box-sizing:border-box; }
  html { scroll-padding-top: env(safe-area-inset-top,0px); }
  body { margin:0; min-height:100%; background:var(--bg); color:var(--ink); font-family:'Cormorant Garamond',Georgia,serif;
    padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
    display:flex; flex-direction:column; align-items:center; overflow-x:hidden; }
  .wrap { width:100%; max-width:640px; padding:32px 20px 40px; display:flex; flex-direction:column; align-items:center; }
  .brand { display:flex; align-items:center; gap:10px; font-size:14px; letter-spacing:.18em; text-transform:uppercase;
    color:color-mix(in srgb, var(--ink) 55%, transparent); margin-bottom:28px; }
  .brand .line { width:24px; height:1px; background:color-mix(in srgb, var(--ink) 20%, transparent); }
  .stage { position:relative; width:min(72vw,320px); height:min(72vw,320px); max-height:340px; border-radius:50%;
    background:radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--gold) 60%, transparent), transparent 70%);
    display:flex; align-items:center; justify-content:center; }
  .layer { position:absolute; inset:0; display:flex; align-items:flex-end; justify-content:center; opacity:0;
    transform:translateY(10px) scale(.95); filter:blur(.7px);
    transition:opacity 900ms cubic-bezier(.37,0,.63,1), transform 900ms cubic-bezier(.37,0,.63,1), filter 900ms cubic-bezier(.37,0,.63,1); }
  .layer.active { opacity:1; transform:translateY(0) scale(1); filter:blur(0); }
  .layer img { height:115%; max-width:none; object-fit:contain; -webkit-user-drag:none; user-select:none; }
  .pose-meta { margin-top:22px; display:flex; flex-direction:column; align-items:center; gap:4px; text-align:center; min-height:90px; }
  .pose-name { font-size:26px; font-weight:600; }
  .pose-sub { font-size:14px; letter-spacing:.1em; text-transform:uppercase; color:color-mix(in srgb, var(--ink) 55%, transparent); }
  .pose-mantra { font-size:13px; font-style:italic; color:color-mix(in srgb, var(--ink) 40%, transparent); margin-top:4px; }
  .dots { display:flex; gap:8px; margin-top:20px; }
  .dot { width:8px; height:8px; border-radius:50%; background:color-mix(in srgb, var(--ink) 15%, transparent);
    transition:background 400ms ease, transform 400ms ease; }
  .dot.active { background:var(--gold-deep); transform:scale(1.3); }
  .cta { margin-top:40px; width:100%; background:var(--card); border:1px solid var(--border); border-radius:18px; padding:24px 22px; text-align:center; }
  .cta h2 { margin:0 0 8px; font-size:22px; font-weight:600; }
  .cta p { margin:0 0 18px; font-size:15px; color:color-mix(in srgb, var(--ink) 65%, transparent); line-height:1.5; }
  .cta-buttons { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; }
  .btn { font-family:inherit; font-size:15px; letter-spacing:.02em; padding:12px 22px; border-radius:999px; border:1px solid var(--border);
    cursor:pointer; text-decoration:none; display:inline-block; }
  .btn-primary { background:var(--gold-deep); color:var(--card); border-color:var(--gold-deep); }
  .btn-secondary { background:transparent; color:var(--ink); }
  .price { font-size:13px; margin-top:14px; color:color-mix(in srgb, var(--ink) 50%, transparent); }
  .price b { color:var(--gold-deep); }
</style>
</head>
<body>
<div class="wrap">
  <div class="brand"><span class="line"></span>Tai Chi · Flujo Natural<span class="line"></span></div>
  <div class="stage" id="stage"></div>
  <div class="pose-meta">
    <div class="pose-name" id="poseName"></div>
    <div class="pose-sub" id="poseSub"></div>
    <div class="pose-mantra" id="poseMantra"></div>
  </div>
  <div class="dots" id="dots"></div>
  <div class="cta">
    <h2>Clase completa de 15 minutos</h2>
    <p>Wuji, Melena del Caballo Salvaje, Grulla Blanca, Manos como Nubes y más — guiada paso a paso para practicar en casa.</p>
    <div class="cta-buttons">
      <a class="btn btn-primary" href="https://malabueno30-prog.github.io/respira-coaching-/" id="webLink">Ver clase completa</a>
      <a class="btn btn-secondary" href="https://www.youtube.com/@cristobalcaliz9018" id="ytLink">Suscríbete en YouTube</a>
    </div>
    <div class="price">Clase completa disponible por <b>15€</b> en la web</div>
  </div>
</div>
<script>
  const poses = [
  { name: "Postura Wuji", sub: "Enraizamiento inicial", mantra: "el aire baja • enraíza", src: "IMG1_PEGAR_AQUI" },
  { name: "Acariciar la Melena del Caballo", sub: "Zuo You Ye Ma Fen Zong", mantra: "transición como agua", src: "IMG2_PEGAR_AQUI" },
  { name: "Elevar el Agua", sub: "Comienzo del Tai Chi", mantra: "el aire sube • pecho se abre", src: "IMG3_PEGAR_AQUI" },
  { name: "Manos como Nubes", sub: "Yun Shou", mantra: "flotar sin interrupción", src: "IMG4_PEGAR_AQUI" }
  ];
  const stage = document.getElementById('stage');
  const poseName = document.getElementById('poseName');
  const poseSub = document.getElementById('poseSub');
  const poseMantra = document.getElementById('poseMantra');
  const dotsWrap = document.getElementById('dots');
  poses.forEach((p,i) => {
    const layer = document.createElement('div');
    layer.className = 'layer'; layer.id = 'layer-'+i;
    const img = document.createElement('img');
    img.src = p.src; img.alt = p.name; img.draggable = false;
    layer.appendChild(img); stage.appendChild(layer);
    const dot = document.createElement('div');
    dot.className = 'dot'; dot.id = 'dot-'+i;
    dotsWrap.appendChild(dot);
  });
  let current = 0;
  function show(i) {
    poses.forEach((_,j) => {
      document.getElementById('layer-'+j).classList.toggle('active', j===i);
      document.getElementById('dot-'+j).classList.toggle('active', j===i);
    });
    poseName.textContent = poses[i].name;
    poseSub.textContent = poses[i].sub;
    poseMantra.textContent = poses[i].mantra;
  }
  show(0);
  setInterval(() => { current = (current+1) % poses.length; show(current); }, 3200);
</script>
</body>
</html>
